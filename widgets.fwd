      "requiredVersion": "0.0.2",
      "version": "1.18.8",
      "author": "huangxd",
      "url": "https://raw.githubusercontent.com/sevenzx/forward-widgets/refs/heads/master/widgets/danmu_auto.js"
    },
    {
      "id": "forward.auto.danmu_api",
      "title": "弹幕API",
      "description": "从danmu_api获取弹幕",
      "requiredVersion": "0.0.2",
      "version": "1.0.3",
      "author": "huangxd",
      "url": "https://raw.githubusercontent.com/sevenzx/forward-widgets/refs/heads/master/widgets/danmu_api.js"
    },
    {
      "id": "forward.combined.media.lists",
      "title": "影视榜单",
