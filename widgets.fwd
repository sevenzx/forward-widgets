      "url": "https://raw.githubusercontent.com/sevenzx/forward-widgets/refs/heads/master/widgets/douban.js"
    },
    {
      "id": "Trakt",
      "title": "Trakt我看&Trakt个性化推荐",
      "description": "解析Trakt想看、在看、已看、片单、追剧日历以及根据个人数据生成的个性化推荐",
      "requiredVersion": "0.0.1",
